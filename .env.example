# Neon Postgres (set automatically by the Vercel Neon integration; `npx vercel env pull .env.local`)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# 32+ random chars: openssl rand -base64 32
SESSION_SECRET=
# Pseudo of the admin account (Paul)
ADMIN_PSEUDO=
# Testing only — never in production: pretend the lock happened at this ISO date
# LOCK_AT_OVERRIDE=2026-10-01T00:00:00Z
# Required in production (openssl rand -hex 32): Vercel sends it as a Bearer token to /api/cron/daily
CRON_SECRET=
